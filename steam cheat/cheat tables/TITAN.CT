{$lua}
if syntaxcheck then return end
function getHookPoint()
  autoAssemble([[aobscanmodule(getCoords,TITAN.exe,8b 0d ? ? ? ? e8 ? ? ? ? 83 ec ? 8b 4c 24 ? e8 ? ? ? ? e9)
                registersymbol(getCoords)]])
end
[ENABLE]
getHookPoint()
unregisterSymbol('baseCoords')
registerSymbol('baseCoords',readPointer(getAddressSafe('getCoords')+2))

[DISABLE]

unregisterSymbol('getCoords')
unregisterSymbol('baseCoords')

