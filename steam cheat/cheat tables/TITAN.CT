[ENABLE]
aobscanmodule(fastCharge,TITAN.exe,D9 99 C4 03 00 00)
registersymbol(fastCharge)
alloc(newfastCharge,100,fastCharge)
label(codefastCharge)
label(returnfastCharge)
label(trash)
label(fullCharge)
newfastCharge:
  fstp dword ptr [trash]
  fld dword ptr [fullCharge]
codefastCharge:
  fstp dword ptr [ecx+000003C4]
  jmp returnfastCharge
trash:
  dd 0
fullCharge:
  dd (float)0.5
fastCharge:
  jmp newfastCharge
  nop
returnfastCharge:

[DISABLE]
fastCharge:
  db D9 99 C4 03 00 00

unregistersymbol(fastCharge)
dealloc(newfastCharge)

