            <CheatEntry>
              <ID>26125</ID>
              <Description>"Generate Inventory"</Description>
              <Options moHideChildren="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: DeathsDoor.exe
	Version	: 
	Date	: July 20, 2021
	Author	: aSwedishMagyar
}
{$lua}
function createRecord(base,desc,topRec)
	local addList = getAddressList()
    local newRec = addList.createMemoryRecord()
    newRec.Address = base
    newRec.Description = desc
    newRec.Type = 2
    newRec.appendToEntry(topRec)
end
function createHeader(base,desc,topRec)
	local addList = getAddressList()
    local header = addList.createMemoryRecord()
    header.Address = base
    header.Description = desc
    header.IsAddressGroupHeader = true
    header.options = '[moHideChildren]'
    header.appendToEntry(topRec)
    return header
end
function getItemName(base)
	local addr = readPointer(base+0x18)
    if addr == nil then return '' end
    return readString(addr+0x14,100,true)
end
function createItem(base,mainRec)
	local name = getItemName(base)
    local topRec = createHeader(base,name,mainRec)
    createRecord('+InventoryItem.stackCount','stackCount',topRec)
	createRecord('+InventoryItem.maxStack','maxStack',topRec)
end
function generateItemlist(mainRec)
	local base = getAddressSafe('[[Inventory]+Inventory.itemList]')
    local off1 = getAddressSafe('List`1._size')
    local off2 = getAddressSafe('List`1._items')
    local num = readInteger(base+off1) - 1
    base = readPointer(base+off2)+0x20
    for i = 0,num do createItem(readPointer(base+i*8),mainRec) end
end
function removeRecords(mainRec)
    if mainRec ~= nil then
	    while mainRec.Count &gt; 0 do
	       mainRec.Child[0]:Delete()
	    end
    end
end
if syntaxcheck then return end
[ENABLE]
generateItemlist(memrec)
[DISABLE]
removeRecords(memrec)
</AssemblerScript>
