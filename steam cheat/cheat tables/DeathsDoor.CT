---------------------------------------------------------------------------------------------------------------------------------------
--Game		: Death's Door
--Version	:
--Date		: July 20, 2021
--Author	: aSwedishMagyar
---------------------------------------------------------------------------------------------------------------------------------------
--Bulk Function Save/Read
---------------------------------------------------------------------------------------------------------------------------------------
function saveFunctions(funcList)
	local name = 'functionList'
	local file = refreshTableFile(name)
	file.Stream.Position = 0
	local numFuncs = stringToByteTable(#funcList)
	file.Stream.write(numFuncs,#numFuncs)
	for i = 1,#funcList do
		local funcName = funcList[i]
		local funcEncode = encodeFunction(_G[funcList[i]])
		local bytes = stringToByteTable(funcName.."\n"..funcEncode)
		file.Stream.write(bytes,#bytes)
	end
end
function readFunctions()
	local name = 'functionList'
	local file = findTableFile(name)
	if file == nil then return nil end
    local stringStream = createStringStream()
    stringStream.copyFrom(file.Stream,file.Stream.Size)
	local funcList = createStringList()
    funcList.text = stringStream.DataString
    local numFunc = tonumber(funcList[0])
	for i = 1,#numFunc do
		local funcName = funcList[i]
		_G[funcName] = decodeFunction(funcList[i+1])
	end
	funcList.destroy()
end
---------------------------------------------------------------------------------------------------------------------------------------
--Table File Helper Functions
---------------------------------------------------------------------------------------------------------------------------------------
function refreshTableFile(name)
	local file = findTableFile(name)
    if file then file.Delete() end
    return createTableFile(name)
end
function tableFileWriteBytes(file,bytes)
	file.Stream.Position = 0
    file.Stream.write(bytes,#bytes)
end
function createByteTableString(byteTable)
	if byteTable == nil or type(byteTable) ~= 'table' then return end
    local str = ""
	for i = 1,#byteTable do
		local byte = string.format('%0X',byteTable[i])
        str = str..byte
    end
    return str
end
---------------------------------------------------------------------------------------------------------------------------------------
--Get Address From Opcode
---------------------------------------------------------------------------------------------------------------------------------------
function getAddressFromOpcode(opAddr)
	local disassembler = createDisassembler()
	disassembler.disassemble(opAddr)
    local disTable = disassembler.getLastDisassembleData()
    local modrm = disTable.modrmValue
    local param = disTable.parameterValue
    if modrm and modrm ~= 0 then return modrm
    elseif param and param ~= 0 then return param end
	return nil
end
---------------------------------------------------------------------------------------------------------------------------------------
--Enable/Disable Section
---------------------------------------------------------------------------------------------------------------------------------------
function onEnable()
	local luaEngine = GetLuaEngine()
    luaEngine.MenuItem5.doClick()
    readFunctions()
    registerBaseAddresses()
    cleanUpStructures()
    addStructs()
    setUpdateTimer(100)
    setupFOVHotkey()
    luaEngine.hide()
end
function onDisable()
	cleanUpStructures()
    unregisterBaseAddresses()
    removeFOVHotkey()
    setUpdateTimer(1000)
end
function getStaticsList()
	return {'PlayerGlobal','Inventory','UIArrowChargeBar','CameraMovementControl','FovZoom','ForestSpiritController'}
end
function getStructsList()
	return {'PlayerGlobal','Damageable','DamageableCharacter','DamageablePlayer','CharacterMovementControl','DashPower','LadderClimber',
    		'WeaponControl','WeaponOffhandControl','_Weapon','_ArrowPower','UIArrowChargeBar',
    		'Inventory','List`1','InventoryItem',
            'CameraMovementControl','FovZoom','ForestSpiritController'}
end
function registerBaseAddresses()
	local staticsList = getStaticsList()
    for i = 1,#staticsList do setupStatics(staticsList[i]) end
end
function unregisterBaseAddresses()
	local staticsList = getStaticsList()
    for i = 1,#staticsList do unregisterSymbol(staticsList[i]) end
end
function addStructs()
	local structsList = getStructsList()
    for i = 1,#structsList do setupStructure(structsList[i]) end
end
function setUpdateTimer(time)
	local upTimer = getUpdateTimer()
    upTimer.SetInterval(time)
end
function cleanUpStructures()
	local count = 0
	while getStructureCount() ~= 0 do
    	getStructure(0):Destroy()
        count = count + 1
        if count &gt; 1000 then return end
    end
end
---------------------------------------------------------------------------------------------------------------------------------------
--Game Specific Functions
---------------------------------------------------------------------------------------------------------------------------------------
function setGodMode(val)
	local base = getDamageablePlayer()
	local off = getAddressSafe('DamageablePlayer.godmode')
    if base and off then writeBytes(base+off,val) end
end
function checkSprintKey(key)
	local base1 = getCharacterMovementControl()
    local base2 = getLadderClimber()
    local offS = getAddressSafe('CharacterMovementControl.maxSpeed')
    local offA = getAddressSafe('CharacterMovementControl.acceleration')
    local offL = getAddressSafe('LadderClimber.climbSpeed')
    if base1 == nil or base2 == nil or offS == nil or offA == nil or offL == nil then return end
	if isKeyPressed(key) then
    	writeFloat(base1+offS,25)
        writeFloat(base1+offA,25)
        writeFloat(base2+offL,25)
    else
    	writeFloat(base1+offS,12)
        writeFloat(base1+offA,3)
        writeFloat(base2+offL,6)
    end
end
function createMyTimer(func,params,interval)
	if func == nil then return nil end
	local timer = createTimer()
	timer.Interval = interval
	timer.OnTimer = function() func(params) end
	return timer
end
---------------------------------------------------------------------------------------------------------------------------------------
--Pointer Base Functions
---------------------------------------------------------------------------------------------------------------------------------------
function getCharacterMovementControl()
	return getAddressSafe('[[PlayerGlobal]+PlayerGlobal.moveControl]')
end
function getDamageablePlayer()
	return getAddressSafe('[[PlayerGlobal]+PlayerGlobal.dmg]')
end
function getLadderClimber()
	return getAddressSafe('[[PlayerGlobal]+PlayerGlobal.climber]')
end
function getFovZoom()
	return getAddressSafe('[FovZoom]')
end
---------------------------------------------------------------------------------------------------------------------------------------
--Mono Related Functions
---------------------------------------------------------------------------------------------------------------------------------------
function setupStatics(statName)
	local classId = mono_findClass('',statName)
	local stat = mono_class_getStaticFieldAddress(nil, classId)
    if stat and stat ~= 0 then unregisterSymbol(statName); registerSymbol(statName,stat) end
end
function setupStructure(className)
	local classId = mono_findClass('',className)
	local fieldList = mono_class_enumFields(classId)
    local struct = createStructure(className)
    struct.beginUpdate()
    for i = 1,#fieldList do
    	local element = struct.addElement()
        element.setOffset(fieldList[i].offset)
        element.setName(fieldList[i].name)
        element.setVartype(monoTypeToVarType(fieldList[i].monotype))
    end
    struct.endUpdate()
    struct.addToGlobalStructureList()
end
function setupArgs(methodId,args)
    local params = mono_method_get_parameters(methodId)
    local args_t={}
    for i=1, #params.parameters do
      args_t[i] = {}
      args_t[i].type = monoTypeToVartypeLookup[params.parameters[i].type]
	  args_t[i].value = args[i]
    end
    return args_t
end
---------------------------------------------------------------------------------------------------------------------------------------
--Cake-san's Mono Enable/Disable Functions (found here: https://fearlessrevolution.com/viewtopic.php?f=11&amp;t=15628)
---------------------------------------------------------------------------------------------------------------------------------------
function onMemRecPreExecute(memoryrecord, newstate)
  if memoryrecord.Type == vtAutoAssembler then LaunchMonoDataCollector()end
end
function onMemRecPostExecute(memoryrecord, newState, succeeded )
  if memoryrecord.Type == vtAutoAssembler then
    miMonoActivateClick(sender)
  end
end
---------------------------------------------------------------------------------------------------------------------------------------
--FOV Hotkey
---------------------------------------------------------------------------------------------------------------------------------------
function setupFOVHotkey()
    setGlobalDelayBetweenHotkeyActivation(1)
    setGlobalKeyPollInterval(1)
    local VK_CONTROL = 0x11
    local VK_ADD = 0x6B
    local VK_SUBTRACT = 0x6D
    incFOV = createHotkey(increaseFOV,{VK_CONTROL,VK_ADD})
    decFOV = createHotkey(decreaseFOV,{VK_CONTROL,VK_SUBTRACT})
end
function removeFOVHotkey()
    incFOV.destroy()
    decFOV.destroy()
end
function increaseFOV()
	local base = getAddressSafe('[FovZoom]')
    local off = getAddressSafe('FovZoom.currentBaseFov')
	if base == nil or off == nil then return end
    local cVal = readFloat(base+off)
    if cVal == nil then return end
    writeFloat(base+off,cVal+0.1)
end
function decreaseFOV(value)
	local base = getFOVZoom()
    local off = getAddressSafe('FovZoom.currentBaseFov')
	if base == nil or off == nil then return end
    local cVal = readFloat(base+off)
    if cVal == nil then return end
    if cVal-0.1 &lt; 1 then return end
    writeFloat(base+off,cVal-0.1)
end
if syntaxcheck then return end
if process == nil or readInteger(process) == nil then error('Not Attached to DeathsDoor.exe') end
[ENABLE]
mono_initialize()
LaunchMonoDataCollector()
onEnable()
[DISABLE]
onDisable()

