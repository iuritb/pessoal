            <CheatEntry>
              <ID>26123</ID>
              <Description>"Toggle One Hit Kills"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: DeathsDoor.exe
	Version	: 
	Date	: July 20, 2021
	Author	: aSwedishMagyar
}
{$lua}
if syntaxcheck then return end
local base = getAddressSafe('[PlayerGlobal]')
if base == nil or readInteger(base) == nil then error('Unable to find PlayerGlobal instance') end
local className = 'PlayerGlobal'
local methodName = 'ToggleBigDmgMode'
local methodId = mono_findMethod(namespace, className, methodName)
local domainId = nil
[ENABLE]
mono_compile_method(methodId)
mono_invoke_method(domainId, methodId, base, {})
return 'nop'
[DISABLE]
</AssemblerScript>
